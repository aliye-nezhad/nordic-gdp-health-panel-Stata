# Stata do-files are the repository's only detectable source-code language.
*.do linguist-language=Stata

# Documentation and workflow configuration are not source-code languages.
*.md linguist-detectable=false
*.yml linguist-detectable=false
*.yaml linguist-detectable=false
LICENSE linguist-detectable=false

# Research data and generated outputs are artifacts, not source code.
data/** linguist-detectable=false
outputs/** linguist-detectable=false
